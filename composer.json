{
    "name": "jeffersongoncalves/filament-ccpa-risk-assessments",
    "description": "Filament plugin for laravel-ccpa-risk-assessments: CCPA risk assessments in your panel: score risks, record the reviewers' views, approve, schedule the 3-year review, mark the CPPA submission and find activities still missing one.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "filament",
        "filament-plugin",
        "ccpa",
        "cpra",
        "risk-assessment",
        "privacy"
    ],
    "homepage": "https://github.com/jeffersongoncalves/filament-ccpa-risk-assessments",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^3.3",
        "jeffersongoncalves/filament-plugin-core": "^1.0",
        "jeffersongoncalves/laravel-ccpa-risk-assessments": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\CcpaRiskAssessments\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\CcpaRiskAssessments\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Filament\\CcpaRiskAssessments\\CcpaRiskAssessmentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
